@model StaffManager.Models.StaffMember

@{
    ViewData["Title"] = "Delete Staff Member";
}

<div class="pageBox">
    <h2>Delete Staff Member</h2>

    <h3 class="warningText">Are you sure sure you want to delete this staff member?</h3>

    <div class="detailsBox">
        <p><strong>Staff ID:</strong> @Model.StaffId</p>
        <p><strong>Full Name:</strong> @Model.FullName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Position:</strong> @Model.Position</p>
        <p><strong>Unit:</strong> @Model.Unit</p>
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="formBox">
        <input type="hidden" asp-for="StaffId" />

        <button type="submit" class="deleteButton">Yes, Delete</button>

        <a asp-action="Index" class="cancelButton">Cancel</a>
    </form>
</div>

<style>
    .pageBox {
        max-width: 500px;
        margin: 40px auto;
        padding: 30px;
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }

        .pageBox h2 {
            margin-top: 0;
            margin-bottom: 10px;
            color: #1d1f3d;
            border-bottom: 3px solid #ef476f;
            padding-bottom: 12px;
        }

    .warningText {
        color: #ef476f;
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 20px;
    }

    .detailsBox {
        background-color: #fafbff;
        border: 1px solid #eef0f4;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 24px;
    }

        .detailsBox p {
            margin: 8px 0;
            font-size: 14.5px;
            color: #2b2d42;
        }

    .formBox {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .deleteButton {
        padding: 10px 18px;
        background-color: #ef476f;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 14.5px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(239, 71, 111, 0.35);
        transition: all 0.15s ease-in-out;
    }

        .deleteButton:hover {
            background-color: #d93a5f;
            transform: translateY(-1px);
        }

    .cancelButton {
        padding: 10px 18px;
        background-color: #edf2f4;
        color: #2b2d42;
        border: 1px solid #d7dbe0;
        border-radius: 8px;
        font-size: 14.5px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s ease-in-out;
    }

        .cancelButton:hover {
            background-color: #dfe4e8;
        }
</style>
